<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.vicliu624.explicitarchitecture</groupId><artifactId>explicit-architecture-atlas-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../../atlas-parent/pom.xml</relativePath></parent>
    <artifactId>explicit-architecture-atlas-fixture-strict-explicit-java</artifactId>
    <name>Explicit Architecture Atlas :: Fixture :: Strict Explicit Java</name>
    <properties><maven.deploy.skip>true</maven.deploy.skip></properties>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-annotations</artifactId><version>${project.version}</version></dependency>
        <!-- 使 Reactor 明确建立处理器编译顺序；provided 保证 fixture 运行时不携带处理器。 -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-annotation-processor</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-annotation-processor</artifactId><version>${project.version}</version></path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
