<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.vicliu624.explicitarchitecture</groupId><artifactId>explicit-architecture-atlas-parent</artifactId><version>0.0.1</version><relativePath>../../atlas-parent/pom.xml</relativePath></parent>
    <artifactId>explicit-architecture-atlas-server-bootstrap</artifactId>
    <name>Explicit Architecture Atlas :: Server Bootstrap</name>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-application-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-source-jvm</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-file-store</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-content-store</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-source-archive</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-http-api</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- 将可执行服务组合根作为唯一主工件发布，保持 Maven Central
                                 对每个发布 JAR 均可追溯到 sources/Javadocs 的要求。 -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.vicliu624.explicitarchitecture.atlas.server.AtlasServerApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
