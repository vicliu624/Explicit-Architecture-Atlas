<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.vicliu624.explicitarchitecture</groupId><artifactId>explicit-architecture-atlas-parent</artifactId><version>0.0.1</version><relativePath>../../atlas-parent/pom.xml</relativePath></parent>
    <artifactId>explicit-architecture-atlas-cli</artifactId>
    <name>Explicit Architecture Atlas :: CLI</name>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-application-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-file-store</artifactId><version>${project.version}</version></dependency>
        <!-- CLI 可以直接分析普通 Java 源码；这个 analyzer 仅依赖 JDK/Atlas SPI，不会带入任何框架。 -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-source-jvm</artifactId><version>${project.version}</version></dependency>
        <!-- Maven 是构建元数据，不是业务框架；默认 CLI 同时读取通用 Maven 模块与依赖事实。 -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-maven-source</artifactId><version>${project.version}</version></dependency>
        <!-- 仅为离线 Axon 观测的 CLI 契约测试提供 ServiceLoader 实现，绝不随普通 CLI 发布。 -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-axon-source</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>explicit-architecture-atlas-axon-runtime</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration><archive><manifest><mainClass>io.github.vicliu624.explicitarchitecture.atlas.cli.AtlasCli</mainClass></manifest></archive></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- 发布的主工件必须是可直接执行的 fat JAR，避免额外 classifier
                                 作为没有对应 sources/Javadocs 的第二个公共 JAR。 -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- 多个 analyzer/provider 都通过 SPI 发布；不合并服务描述文件会让 fat jar 随机丢失 adapter。 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.vicliu624.explicitarchitecture.atlas.cli.AtlasCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
