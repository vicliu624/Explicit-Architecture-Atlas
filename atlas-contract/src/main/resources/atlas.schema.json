{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explicit-architecture-atlas.dev/schema/atlas-package/1.0",
  "title": "Explicit Architecture Atlas Package",
  "type": "object",
  "required": ["manifest", "designAtlas", "facts", "intents", "content", "diagnostics"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "designAtlas": { "$ref": "#/$defs/designAtlas" },
    "facts": { "$ref": "#/$defs/factBundle" },
    "intents": { "$ref": "#/$defs/intentBundle" },
    "content": { "$ref": "#/$defs/contentBundle" },
    "runtimeOverlay": { "$ref": "#/$defs/runtimeOverlay" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "packageId", "projectId", "sourceRevision", "generatedAt", "coverage"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "packageId": { "$ref": "#/$defs/id" },
        "projectId": { "$ref": "#/$defs/id" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["analyzerId", "status", "scopeUri"],
      "properties": {
        "analyzerId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["COMPLETE", "PARTIAL", "NOT_ENABLED", "NOT_IMPLEMENTED", "NOT_APPLICABLE", "FAILED"] },
        "scopeUri": { "type": "string", "pattern": "^project://" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "designAtlas": {
      "type": "object",
      "required": ["nodes", "relations"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
      },
      "additionalProperties": false
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "kind", "name", "attributes", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/businessConcept" },
        { "$ref": "#/$defs/domainConstraint" },
        { "$ref": "#/$defs/domainEvent" },
        { "$ref": "#/$defs/applicationUseCase" },
        { "$ref": "#/$defs/projection" },
        { "$ref": "#/$defs/processManager" },
        { "$ref": "#/$defs/endpointOperation" },
        { "$ref": "#/$defs/codeElement" },
        { "$ref": "#/$defs/dataTarget" },
        { "$ref": "#/$defs/externalBoundary" },
        { "$ref": "#/$defs/semanticValue" },
        { "$ref": "#/$defs/operationContract" },
        { "$ref": "#/$defs/componentDefinition" },
        { "$ref": "#/$defs/injectionPoint" },
        { "$ref": "#/$defs/configurationProperty" },
        { "$ref": "#/$defs/configurationScenario" }
      ]
    },
    "businessConcept": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "BUSINESS_CONCEPT" }, "responsibility": { "type": "string", "minLength": 1 } }, "required": ["responsibility"] }
      ],
      "unevaluatedProperties": false
    },
    "domainConstraint": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "DOMAIN_CONSTRAINT" }, "subjectId": { "$ref": "#/$defs/id" }, "constraintKind": { "enum": ["REQUIRED", "IDENTITY_FORMAT", "VALUE_RANGE", "CROSS_CONCEPT_CONSISTENCY", "UNIQUENESS", "STATE_TRANSITION", "EVENT_PRECONDITION", "TEMPORAL", "OWNERSHIP", "COMPENSATION", "CUSTOM"] }, "enforcementLevel": { "enum": ["HARD", "CONDITIONAL", "ADVISORY"] }, "statement": { "type": "string", "minLength": 1 } }, "required": ["subjectId", "constraintKind", "enforcementLevel", "statement"] }
      ],
      "unevaluatedProperties": false
    },
    "domainEvent": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "DOMAIN_EVENT" }, "businessFact": { "type": "string", "minLength": 1 }, "payload": { "type": "array", "items": { "$ref": "#/$defs/eventField" } } }, "required": ["businessFact", "payload"] }
      ],
      "unevaluatedProperties": false
    },
    "applicationUseCase": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "APPLICATION_USE_CASE" }, "purpose": { "type": "string", "minLength": 1 } }, "required": ["purpose"] }
      ],
      "unevaluatedProperties": false
    },
    "projection": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "PROJECTION" }, "purpose": { "type": "string", "minLength": 1 } }, "required": ["purpose"] }
      ],
      "unevaluatedProperties": false
    },
    "processManager": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "PROCESS_MANAGER" }, "responsibility": { "type": "string", "minLength": 1 }, "completionCondition": { "type": "string" } }, "required": ["responsibility"] }
      ],
      "unevaluatedProperties": false
    },
    "endpointOperation": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "ENDPOINT_OPERATION" }, "purpose": { "type": "string", "minLength": 1 } }, "required": ["purpose"] }
      ],
      "unevaluatedProperties": false
    },
    "codeElement": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "CODE_ELEMENT" }, "elementKind": { "enum": ["PACKAGE", "TYPE", "RECORD_COMPONENT", "FIELD", "CONSTRUCTOR", "METHOD", "PARAMETER", "ANNOTATION", "CONFIGURATION"] }, "qualifiedName": { "type": "string", "minLength": 1 }, "locator": { "$ref": "#/$defs/locator" } }, "required": ["elementKind", "qualifiedName", "locator"] }
      ],
      "unevaluatedProperties": false
    },
    "dataTarget": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "DATA_TARGET" }, "targetKind": { "enum": ["PERSISTENCE_ENTITY", "DATABASE_TABLE", "DATABASE_COLUMN", "DATABASE_VIEW", "CACHE", "SEARCH_INDEX", "MESSAGE_TOPIC", "EXTERNAL_SYSTEM", "FILE", "UNSPECIFIED"] } }, "required": ["targetKind"] }
      ],
      "unevaluatedProperties": false
    },
    "externalBoundary": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "EXTERNAL_BOUNDARY" }, "boundaryKind": { "enum": ["REST_API", "MESSAGE_BROKER", "REMOTE_SERVICE", "IDENTITY_PROVIDER", "FILE_EXCHANGE", "HUMAN_OPERATOR", "UNSPECIFIED"] }, "responsibility": { "type": "string", "minLength": 1 } }, "required": ["boundaryKind", "responsibility"] }
      ],
      "unevaluatedProperties": false
    },
    "semanticValue": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "SEMANTIC_VALUE" }, "semanticCategory": { "enum": ["RAW_INPUT", "DOMAIN_PRIMITIVE", "VALUE_OBJECT", "ENTITY_IDENTIFIER", "AGGREGATE_STATE", "COMMAND_PAYLOAD", "EVENT_PAYLOAD", "QUERY_FILTER", "READ_MODEL_VALUE", "PERSISTED_REPRESENTATION", "EXTERNAL_REQUEST", "EXTERNAL_RESPONSE", "CONFIGURATION_VALUE", "SECURITY_CONTEXT", "TENANT_CONTEXT", "TIME_SOURCE", "ERROR_DETAIL", "AUDIT_VALUE", "SECRET", "CUSTOM"] }, "javaRepresentation": { "type": "string", "minLength": 1 }, "cardinality": { "enum": ["SINGLE", "OPTIONAL", "COLLECTION", "MAP", "STREAM", "ASYNC_SINGLE", "ASYNC_STREAM", "UNKNOWN"] }, "nullability": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL", "UNKNOWN"] }, "trustLevel": { "enum": ["EXTERNAL_UNTRUSTED", "INTERNAL", "VERIFIED", "SYSTEM_GENERATED", "UNKNOWN"] }, "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "PII", "SECRET", "UNKNOWN"] }, "lifecycleState": { "type": "string", "minLength": 1 } }, "required": ["semanticCategory", "javaRepresentation", "cardinality", "nullability", "trustLevel", "sensitivity", "lifecycleState"] }
      ],
      "unevaluatedProperties": false
    },
    "operationContract": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "OPERATION_CONTRACT" }, "operationKind": { "enum": ["METHOD", "CONSTRUCTOR", "HTTP_ENDPOINT", "MESSAGE_CONSUMER", "EVENT_HANDLER", "COMMAND_HANDLER", "QUERY_HANDLER", "SCHEDULED_TASK", "LAMBDA", "FRAMEWORK_CALLBACK", "FACTORY_METHOD", "CUSTOM"] }, "javaSignature": { "type": "string", "minLength": 1 }, "locator": { "$ref": "#/$defs/locator" }, "inputs": { "type": "array", "items": { "$ref": "#/$defs/operationInput" } }, "outcomes": { "type": "array", "items": { "$ref": "#/$defs/operationOutcome" } }, "failures": { "type": "array", "items": { "$ref": "#/$defs/operationFailure" } } }, "required": ["operationKind", "javaSignature", "locator", "inputs", "outcomes", "failures"] }
      ],
      "unevaluatedProperties": false
    },
    "operationInput": {
      "type": "object",
      "required": ["name", "javaType", "role", "implicit", "nullability", "description"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "javaType": { "type": "string", "minLength": 1 }, "role": { "enum": ["BUSINESS_INPUT", "RAW_INPUT", "DOMAIN_PRIMITIVE", "COMMAND", "QUERY", "EVENT", "DEPENDENCY", "RECEIVER_STATE", "CONFIGURATION", "SECURITY_CONTEXT", "TENANT_CONTEXT", "TRANSACTION_CONTEXT", "TIME_SOURCE", "EXTERNAL_RESPONSE", "PERSISTENCE_READ", "CUSTOM"] }, "implicit": { "type": "boolean" }, "nullability": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL", "UNKNOWN"] }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "operationOutcome": {
      "type": "object",
      "required": ["kind", "name", "javaType", "condition", "description"],
      "properties": { "kind": { "enum": ["RETURN_VALUE", "STATE_MUTATION", "EVENT_PUBLICATION", "PERSISTENCE_WRITE", "CACHE_WRITE", "EXTERNAL_CALL", "ASYNC_CONTINUATION", "AUDIT_RECORD", "CUSTOM"] }, "name": { "type": "string", "minLength": 1 }, "javaType": { "type": "string", "minLength": 1 }, "condition": { "type": "string" }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "operationFailure": {
      "type": "object",
      "required": ["exceptionType", "condition", "description"],
      "properties": { "exceptionType": { "type": "string", "minLength": 1 }, "condition": { "type": "string" }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "componentDefinition": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "COMPONENT_DEFINITION" }, "componentKind": { "enum": ["COMPONENT", "SERVICE", "REPOSITORY", "CONTROLLER", "CONFIGURATION", "FACTORY_METHOD", "FACTORY_BEAN", "AUTO_CONFIGURATION", "XML_DEFINITION", "PROGRAMMATIC", "TEST_CONFIGURATION", "CUSTOM"] }, "beanName": { "type": "string", "minLength": 1 }, "declaredType": { "type": "string", "minLength": 1 }, "candidateType": { "type": "string", "minLength": 1 }, "scope": { "enum": ["SINGLETON", "PROTOTYPE", "REQUEST", "SESSION", "APPLICATION", "THREAD", "REFRESH", "CUSTOM", "UNKNOWN"] }, "primary": { "type": "boolean" }, "qualifiers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "activationCondition": { "$ref": "#/$defs/conditionExpression" } }, "required": ["componentKind", "beanName", "declaredType", "candidateType", "scope", "primary", "qualifiers", "activationCondition"] }
      ],
      "unevaluatedProperties": false
    },
    "conditionExpression": {
      "type": "object",
      "required": ["canonicalForm", "status", "terms"],
      "properties": { "canonicalForm": { "type": "string", "minLength": 1 }, "status": { "enum": ["POSSIBLE", "ACTIVE", "EXCLUDED", "UNRESOLVED", "OBSERVED"] }, "terms": { "type": "array", "items": { "$ref": "#/$defs/conditionTerm" } } },
      "additionalProperties": false
    },
    "conditionTerm": {
      "type": "object",
      "required": ["kind", "subject", "operator", "expectedValue"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "subject": { "type": "string", "minLength": 1 }, "operator": { "type": "string", "minLength": 1 }, "expectedValue": { "type": "string" } },
      "additionalProperties": false
    },
    "injectionPoint": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "INJECTION_POINT" }, "ownerComponentId": { "$ref": "#/$defs/id" }, "requestedType": { "type": "string", "minLength": 1 }, "injectionKind": { "enum": ["CONSTRUCTOR", "FIELD", "SETTER", "METHOD_PARAMETER", "LOOKUP_METHOD", "OBJECT_PROVIDER", "OBJECT_FACTORY", "APPLICATION_CONTEXT_LOOKUP", "BEAN_FACTORY_LOOKUP", "PROGRAMMATIC_LOOKUP", "CUSTOM"] }, "injectionCardinality": { "enum": ["SINGLE", "OPTIONAL", "COLLECTION", "MAP", "PROVIDER", "UNKNOWN"] }, "required": { "type": "boolean" }, "qualifiers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "required": ["ownerComponentId", "requestedType", "injectionKind", "injectionCardinality", "required", "qualifiers"] }
      ],
      "unevaluatedProperties": false
    },
    "configurationProperty": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "CONFIGURATION_PROPERTY" }, "propertyKey": { "type": "string", "minLength": 1 }, "declaredDefault": { "type": "string" }, "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "PII", "SECRET", "UNKNOWN"] } }, "required": ["propertyKey", "declaredDefault", "sensitivity"] }
      ],
      "unevaluatedProperties": false
    },
    "configurationScenario": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "properties": { "kind": { "const": "CONFIGURATION_SCENARIO" }, "activeProfiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scenarioProperty" } }, "classpathCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "required": ["activeProfiles", "properties", "classpathCapabilities"] }
      ],
      "unevaluatedProperties": false
    },
    "scenarioProperty": {
      "type": "object",
      "required": ["provenance", "value", "redacted"],
      "properties": { "provenance": { "type": "string", "minLength": 1 }, "value": { "type": "string" }, "redacted": { "type": "boolean" } },
      "additionalProperties": false
    },
    "eventField": {
      "type": "object",
      "required": ["name", "role"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "role": { "enum": ["BUSINESS_IDENTITY", "BUSINESS_FACT", "CORRELATION", "TRACE", "SENSITIVE", "TECHNICAL", "UNSPECIFIED"] }, "businessMeaning": { "type": "string" } },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "kind", "sourceId", "targetId", "attributes", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["REPRESENTS", "CONTAINS", "DEPENDS_ON", "EXPOSES_TO", "CONSTRAINS", "CALLS", "HANDLES", "PRODUCES", "CONSUMES", "PUBLISHES", "PROJECTS_TO", "WRITES_TO", "STARTS", "WAITS_FOR", "DISPATCHES", "COMPLETES", "COMPENSATES", "EVIDENCED_BY", "ACCEPTS", "RETURNS", "ARGUMENT_BINDS_TO", "RETURN_FLOWS_TO", "DERIVES_FROM", "NORMALIZES", "VALIDATES", "MUTATES_STATE", "READS_FROM", "SERIALIZES_AS", "DESERIALIZES_FROM", "IMPLEMENTS", "OVERRIDES", "DELEGATES_TO", "LOOKS_UP", "DEFINES_BEAN", "REQUESTS_BEAN", "RESOLVES_TO", "ACTIVATES_WHEN", "EXCLUDES_WHEN", "PROXIES", "INTERCEPTS", "BYPASSES_PROXY", "CROSSES_ASYNC_BOUNDARY", "CALLS_EXTERNAL", "BYPASSES_DOMAIN_PRIMITIVE", "CONTRADICTS", "DOCUMENTS"] },
        "sourceId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    },
    "locator": {
      "type": "object",
      "required": ["uri", "symbol", "range"],
      "properties": {
        "uri": { "type": "string", "pattern": "^(project|archive|maven|runtime|document|generated)://" },
        "symbol": { "type": "string" },
        "range": { "type": "object", "required": ["startLine", "startColumn", "endLine", "endColumn"], "properties": { "startLine": { "type": "integer", "minimum": 0 }, "startColumn": { "type": "integer", "minimum": 0 }, "endLine": { "type": "integer", "minimum": 0 }, "endColumn": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "origin", "claim", "status", "locator", "sourceRevision", "visibility", "analyzerId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "origin": { "enum": ["SOURCE_CODE", "MAVEN_MODEL", "ANNOTATION_MANIFEST", "WORKSPACE_CONFIGURATION", "CONTENT_BUNDLE", "RUNTIME_SYSTEM", "SOURCE_ARCHIVE", "PLANNED_DOCUMENT"] },
        "claim": { "enum": ["DECLARED", "DERIVED", "OBSERVED", "PLANNED"] },
        "status": { "enum": ["VERIFIED", "PARTIAL", "PENDING", "CONFLICTED"] },
        "locator": { "$ref": "#/$defs/locator" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["BUSINESS_SAFE", "OPS_SAFE", "EXPERT_ONLY", "RESTRICTED"] },
        "analyzerId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "factBundle": {
      "type": "object",
      "required": ["facts", "relations"],
      "properties": {
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/factRelation" } }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "analyzerId", "kind", "subject", "attributes", "evidence"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "analyzerId": { "type": "string", "minLength": 1 }, "kind": { "enum": ["PROJECT", "MAVEN_MODULE", "MAVEN_DEPENDENCY", "SOURCE_TYPE", "SOURCE_FIELD", "SOURCE_METHOD", "SOURCE_PARAMETER", "SOURCE_RETURN", "ANNOTATION", "VALIDATION_RULE", "GUARD_DEFINITION", "METHOD_CALL", "METHOD_ARGUMENT_FLOW", "METHOD_RETURN_FLOW", "VALUE_NORMALIZATION", "HTTP_ENDPOINT", "COMMAND_DISPATCH", "COMMAND_HANDLER", "EVENT_PUBLICATION", "EVENT_CONSUMPTION", "EVENT_PAYLOAD_FIELD", "PERSISTENCE_ENTITY", "PERSISTENCE_TABLE", "PERSISTENCE_COLUMN", "REPOSITORY", "PROJECTION_WRITE", "PROCESS_START", "PROCESS_WAIT", "PROCESS_DISPATCH", "PROCESS_COMPLETION", "BEAN_DEFINITION", "BEAN_INJECTION", "BEAN_CONDITION", "CONFIGURATION_PROPERTY", "AOP_ADVISOR", "RUNTIME_MEASUREMENT"] }, "subject": { "type": "string", "minLength": 1 }, "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "factRelation": {
      "type": "object",
      "required": ["id", "kind", "sourceFactId", "targetFactId", "attributes", "evidence"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "$ref": "#/$defs/relation/properties/kind" }, "sourceFactId": { "$ref": "#/$defs/id" }, "targetFactId": { "$ref": "#/$defs/id" }, "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "intentBundle": { "type": "object", "required": ["declarations"], "properties": { "declarations": { "type": "array", "items": { "$ref": "#/$defs/intent" } } }, "additionalProperties": false },
    "intent": {
      "type": "object",
      "required": ["id", "annotationType", "assetKind", "target", "attributes", "evidence"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "annotationType": { "type": "string", "minLength": 1 }, "assetKind": { "type": "string" }, "target": { "type": "object", "required": ["kind", "binaryName", "memberDescriptor"], "properties": { "kind": { "type": "string" }, "binaryName": { "type": "string", "minLength": 1 }, "memberDescriptor": { "type": "string" } }, "additionalProperties": false }, "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }, "evidence": { "$ref": "#/$defs/evidence" } },
      "additionalProperties": false
    },
    "contentBundle": { "type": "object", "required": ["entries"], "properties": { "entries": { "type": "array", "items": { "$ref": "#/$defs/contentEntry" } } }, "additionalProperties": false },
    "contentEntry": {
      "type": "object",
      "required": ["id", "assetId", "audience", "title", "explanation", "actionWhenViolated", "evidence"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "assetId": { "$ref": "#/$defs/id" }, "audience": { "enum": ["BUSINESS", "OPS", "EXPERT"] }, "title": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1 }, "actionWhenViolated": { "type": "string" }, "evidence": { "$ref": "#/$defs/evidence" } },
      "additionalProperties": false
    },
    "runtimeOverlay": { "type": "object", "required": ["capturedAt", "observations"], "properties": { "capturedAt": { "type": "string", "format": "date-time" }, "observations": { "type": "array", "items": { "$ref": "#/$defs/runtimeObservation" } } }, "additionalProperties": false },
    "runtimeObservation": { "type": "object", "required": ["id", "subjectId", "observedAt", "observationType", "attributes", "evidence"], "properties": { "id": { "$ref": "#/$defs/id" }, "subjectId": { "$ref": "#/$defs/id" }, "observedAt": { "type": "string", "format": "date-time" }, "observationType": { "type": "string", "minLength": 1 }, "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }, "evidence": { "$ref": "#/$defs/evidence" } }, "additionalProperties": false },
    "diagnostic": { "type": "object", "required": ["id", "severity", "code", "message"], "properties": { "id": { "$ref": "#/$defs/id" }, "severity": { "enum": ["INFO", "WARNING", "ERROR"] }, "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "locator": { "$ref": "#/$defs/locator" } }, "additionalProperties": false }
  }
}
